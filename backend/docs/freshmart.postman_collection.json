{
  "info": {
    "name": "FreshMart backend starter",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "FreshMart phần A. Chạy Starter trước; Auth cần userEmail/userPassword; Admin cần adminEmail/adminPassword trong Postman Environment. Cookie jar và csrfToken được giữ giữa các request. API phần B xem backend-contract.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Starter",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/missing"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{broken"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"INVALID_JSON\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalog - requires seeded MongoDB",
      "item": [
        {
          "name": "Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/not-a-real-product"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"PRODUCT_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth - configure userEmail and userPassword",
      "item": [
        {
          "name": "Get session and CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 || pm.response.code === 201) { const data = pm.response.json(); if(data.csrfToken) pm.collectionVariables.set(\"csrfToken\", data.csrfToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 || pm.response.code === 201) { const data = pm.response.json(); if(data.csrfToken) pm.collectionVariables.set(\"csrfToken\", data.csrfToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer denied admin users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.unset(\"csrfToken\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile denied after logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin - configure adminEmail and adminPassword",
      "item": [
        {
          "name": "Get session and CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 || pm.response.code === 201) { const data = pm.response.json(); if(data.csrfToken) pm.collectionVariables.set(\"csrfToken\", data.csrfToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 || pm.response.code === 201) { const data = pm.response.json(); if(data.csrfToken) pm.collectionVariables.set(\"csrfToken\", data.csrfToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/users?page=1&pageSize=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin products including hidden",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/products?page=1&pageSize=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.unset(\"csrfToken\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Recovery - dev inbox or configured SMTP",
      "description": "Chạy yêu cầu khôi phục trước. Local: xem npm run mail:inbox rồi điền resetToken. Không chạy reset nếu chưa có token hợp lệ.",
      "item": [
        {
          "name": "Get session and CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 || pm.response.code === 201) { const data = pm.response.json(); if(data.csrfToken) pm.collectionVariables.set(\"csrfToken\", data.csrfToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Request password recovery",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset with one-use token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/reset-password",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
