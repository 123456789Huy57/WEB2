NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
# Set a local or Atlas URI to enable database-backed APIs and sessions.
# Local example: mongodb://127.0.0.1:27017
# Leave empty to check the starter without MongoDB (development only).
MONGODB_URI=
MONGODB_DB=freshmart
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without a secret, development uses a temporary secret that changes on restart.
SESSION_SECRET=
# Only used by npm run seed:admin (no default accounts are created).
DEV_ADMIN_EMAIL=
DEV_ADMIN_PHONE=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME=FreshMart Admin
# Gửi email (quên mật khẩu, đăng ký nhận ưu đãi).
# Để trống SMTP_* thì máy dev ghi thư vào backend/.local-mail (xem bằng: npm run mail:inbox), KHÔNG gửi email thật.
# Gửi email thật bằng Gmail: bật xác minh 2 bước -> myaccount.google.com/apppasswords -> tạo "Mật khẩu ứng dụng" 16 ký tự
# rồi điền 5 dòng dưới (SMTP_PASSWORD là mật khẩu ứng dụng, không phải mật khẩu Gmail). Điền đủ là tự gửi thật.
MAIL_TRANSPORT=
# Ví dụ Gmail: MAIL_FROM="FreshMart <ban@gmail.com>", SMTP_HOST=smtp.gmail.com, SMTP_USER=ban@gmail.com
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Mã giảm giá gửi kèm thư chào mừng khi đăng ký nhận ưu đãi (phải đang bật trong DB).
NEWSLETTER_VOUCHER=WELCOME10
# Thanh toán online. Để trống VNPAY_* thì dùng cổng giả lập (mock) để thử.
# Mã sandbox lấy tại sandbox.vnpayment.vn (đăng ký merchant test).
PAYMENT_PROVIDER=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Chuyển khoản QR tự xác nhận qua SePay. Thiếu một biến thì ẩn lựa chọn này.
# BANK_CODE theo tên SePay (MBBank, Vietcombank, ACB...). SEPAY_API_KEY trùng API Key đặt ở webhook SePay.
BANK_CODE=
BANK_ACCOUNT=
BANK_HOLDER=
SEPAY_API_KEY=
# Địa chỉ backend mà trình duyệt mở được (cổng thanh toán trả khách về đây)
BACKEND_URL=http://localhost:3000
# Lưu ảnh trên Cloudinary (cloudinary.com → Settings → API Keys). Để trống thì lưu thư mục local.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=freshmart
# Deploy: số proxy đứng trước backend (Vercel + Render = 2). Chạy trên máy thì để 0 hoặc bỏ trống.
TRUST_PROXY=
