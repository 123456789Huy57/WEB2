NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
# Set a local or Atlas URI to enable database-backed APIs and sessions.
# Local example: mongodb://127.0.0.1:27017
# Leave empty to check the starter without MongoDB (development only).
MONGODB_URI=
MONGODB_DB=freshmart
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without a secret, development uses a temporary secret that changes on restart.
SESSION_SECRET=
# Only used by npm run seed:admin (no default accounts are created).
DEV_ADMIN_EMAIL=
DEV_ADMIN_PHONE=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME=FreshMart Admin
# Development mail goes to a private local inbox, not a real email address.
MAIL_TRANSPORT=outbox
# For real email: MAIL_TRANSPORT=smtp and fill the fields below.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
